# Copy only the values you intend to use into your shell or an ignored .env.
# This file is configuration documentation; the preflight never makes model calls.
GRAPHITI_NEO4J_URI=bolt://127.0.0.1:17687
GRAPHITI_NEO4J_USER=neo4j
GRAPHITI_NEO4J_PASSWORD=replace-me
GRAPHITI_NEO4J_DATABASE=neo4j

# OpenAI-compatible chat endpoint. Graphiti requires reliable structured JSON.
GRAPHITI_LLM_BASE_URL=https://provider.example/v1
GRAPHITI_LLM_API_KEY=replace-me
GRAPHITI_LLM_MODEL=vertex_ai/gemini-3.8-flash
GRAPHITI_SMALL_MODEL=vertex_ai/gemini-3.8-flash
GRAPHITI_STRUCTURED_OUTPUT_MODE=json_schema
# Generic-client default; native helpers may request a larger cap.
# The smoke ledger enforces actual per-request reservations and its aggregate ceiling.
GRAPHITI_MAX_TOKENS=4096
GRAPHITI_REQUEST_TIMEOUT_SECONDS=90

# OpenAI-compatible embedding endpoint; it may differ from the chat endpoint.
GRAPHITI_EMBED_BASE_URL=https://provider.example/v1
GRAPHITI_EMBED_API_KEY=replace-me
GRAPHITI_EMBED_MODEL=text-embedding-3-small
GRAPHITI_EMBED_DIM=3072
EMBEDDING_DIM=3072

# Graphiti telemetry is opt-out upstream. Keep comparison traffic local except
# for the explicitly configured model endpoints.
GRAPHITI_TELEMETRY_ENABLED=false
SEMAPHORE_LIMIT=2
